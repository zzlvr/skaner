# Copy this file to .env and fill in the values. Never commit .env.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Which provider to use: gemini or claude
DOCSTRUC_BACKEND=gemini
# Optional: override the model of the selected provider
DOCSTRUC_MODEL=

# Telegram bot (python -m bot.main)
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id (send /id to the bot) — enables /grant and /stats
BOT_OWNER_ID=
# How users contact you to buy documents, e.g. @your_username
BOT_OWNER_CONTACT=
BOT_PRICES_TEXT=
BOT_FREE_DOCS=0
BOT_DAILY_DOC_LIMIT=200

# Website (python -m web). Dev: WEB_DEV=1 (console mail, auto migrations). Production: run `alembic upgrade head` first.
WEB_DEV=
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))". Changing it logs everyone out
# and makes existing email fingerprints unmatchable (accounts become unreachable), so keep it stable and backed up.
WEB_SECRET=
WEB_BASE_URL=https://skaner.app
WEB_DB_URL=sqlite:///data/web.sqlite3
# Mail for login codes (Resend). Required outside dev; the sender domain must be verified at Resend.
RESEND_API_KEY=
WEB_MAIL_FROM=Skaner <login@skaner.app>
# Owner admin at /admin: comma-separated sign-in addresses of the owner. Kept in the environment only; the site
# compares fingerprints and stores nothing that marks an admin. Empty: /admin is a 404 for everyone.
WEB_ADMIN_EMAILS=
# Daily cap of recognised pages for the whole site (UTC day), and the part of it that batches paid only by trial
# pages may use (clamped to WEB_DAILY_PAGES), so trial accounts can never use up the cap of paying customers.
WEB_DAILY_PAGES=300
WEB_TRIAL_DAILY_PAGES=100
# Payment requests ("Хочу оплатить") are also sent to the owner in Telegram through the bot above:
# the website reads TELEGRAM_BOT_TOKEN and BOT_OWNER_ID (set them once, above). Without them requests are only
# listed at /admin/requests.

# One trial per phone number, confirmed in the Telegram bot (off unless WEB_PHONE_VERIFY=1). When on, the site needs
# the bot's username (no @) and PHONE_VERIFY_SECRET (32+ random characters, the SAME value on the bot side, keep it
# stable: changing it makes old phone fingerprints unmatchable). New users get WEB_TRIAL_INSTANT_PAGES at once and the
# rest of WEB_TRIAL_PAGES after confirming the phone. The bot calls the site at WEB_INTERNAL_URL (localhost);
# the reverse proxy must block /internal/ from the internet (nginx: location /internal/ { deny all; }).
WEB_PHONE_VERIFY=
TELEGRAM_BOT_USERNAME=
PHONE_VERIFY_SECRET=
WEB_TRIAL_INSTANT_PAGES=10
# Bot side: where the website listens on the same server (default http://127.0.0.1:8000).
WEB_INTERNAL_URL=http://127.0.0.1:8000

# LOCAL DEVELOPMENT ONLY, put these in the git-ignored .env.dev (never in the production .env: the site refuses to
# start with them outside WEB_DEV=1). A fixed address that always signs in with a fixed 6-digit code:
# WEB_DEMO_EMAIL=demo@skaner.test
# WEB_DEMO_CODE=482915

# No free trial by default (WEB_TRIAL_PAGES=0): people bring their own provider key on the upload page, or pay.
# WEB_TRIAL_PAGES=0
# Where people write to pay (shown on the Plans page; payment is manual, the owner adds pages in /admin). Empty: not shown.
WEB_PAY_EMAIL=
