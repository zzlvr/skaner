# Copy this file to .env and fill in the values. Never commit .env.

# --- Command line and demo (docstruc extract ...) ---
# Your own provider key. The site never needs a key of its own: people paste theirs on the upload page.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Which provider the command line uses: claude or gemini
DOCSTRUC_BACKEND=claude
# Optional: override the model of that provider
DOCSTRUC_MODEL=

# --- Website (python -m web) ---
# Development: WEB_DEV=1 (console mail, automatic migrations, demo sign-in from .env.dev). Production: run
# `alembic upgrade head` first.
WEB_DEV=
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))". Changing it logs everyone out
# and makes existing email fingerprints unmatchable (accounts become unreachable), so keep it stable and backed up.
WEB_SECRET=
WEB_BASE_URL=https://example.org
WEB_DB_URL=sqlite:///data/web.sqlite3
# Address the server binds to (use 0.0.0.0 inside Docker)
WEB_HOST=127.0.0.1
# Mail for sign-in codes (Resend). Required outside dev; the sender domain must be verified at Resend.
RESEND_API_KEY=
WEB_MAIL_FROM=Skaner <login@example.org>
# Owner admin at /admin: comma-separated sign-in addresses of the owner. Kept in the environment only; the site
# compares fingerprints and stores nothing that marks an admin. Empty: /admin is a 404 for everyone.
WEB_ADMIN_EMAILS=
# Optional: notices to the owner in Telegram (a bot token from @BotFather and the owner's numeric user id), and
# the encrypted database copy sent to the owner. Without them messages are only listed at /admin/requests.
TELEGRAM_BOT_TOKEN=
BOT_OWNER_ID=
# Cloudflare Turnstile on the sign-in page: both keys or none.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- The commercial layer (off by default) ---
# Free mode (default): every recognition runs on the user's own key; no prices, plans or payment requests.
# WEB_PAID_PLANS=1 switches on pricing, plans, payment requests, the page balance and WEB_TRIAL_PAGES.
WEB_PAID_PLANS=
# Where people write to pay (shown on the Plans page when paid plans are on).
WEB_PAY_EMAIL=

# Free mode needs no sign-in: visitors get a guest account. Their results are kept this many days, and one network
# may start this many guest sessions a day.
WEB_GUEST_RETENTION_DAYS=7
WEB_GUESTS_PER_IP_DAY=30
WEB_GUESTS_PER_DAY=3000
